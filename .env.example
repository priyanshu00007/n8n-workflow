# ===== Nexus Flow — Environment Configuration =====
# Copy to `.env` and fill in what you need. Every cloud provider is optional;
# the stack works fully offline through the bundled Ollama Docker service.

# --- Core ---
APP_PORT=3000
VAULT_SECRET=change-me-to-a-long-random-string

# --- Ollama (local/offline models, runs in Docker) ---
# Compose-internal endpoint used by the app container:
OLLAMA_HOST=http://ollama:11434
# Port exposed on your machine (for browser/CLI access):
OLLAMA_PORT=11434
# Models auto-pulled at first startup (comma-separated). Leave empty to skip.
# Suggestions: deepseek-r1:7b, llama3.1:8b, qwen2.5:7b, mistral:7b, phi4:latest
OLLAMA_MODELS=qwen2.5:0.5b,deepseek-r1:7b,llama3.1:8b,qwen2.5:7b
# Keep models loaded in memory (-1 = forever). Use e.g. 5m to unload after 5 min.
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2

# --- Google Gemini (optional, online) ---
GEMINI_API_KEY=

# --- OpenAI (optional, online) ---
OPENAI_API_KEY=
# Optional: point OpenAI-compatible client at any custom endpoint
# (Azure OpenAI gateway, OpenRouter, LM Studio, vLLM, etc.)
OPENAI_BASE_URL=

# --- Anthropic Claude (optional, online) ---
ANTHROPIC_API_KEY=

# --- DeepSeek (optional, online) ---
DEEPSEEK_API_KEY=

# --- Groq (optional, online, ultra-fast LPU inference) ---
GROQ_API_KEY=

# --- Qwen / Alibaba DashScope (optional, online) ---
QWEN_API_KEY=

# --- MiniMax (optional, online) ---
MINIMAX_API_KEY=

# --- Email sending (optional — without these, email nodes simulate delivery) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Postgres / Redis (bundled services) ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexuspass
POSTGRES_DB=nexusflow
POSTGRES_PORT=5432
REDIS_PORT=6379
